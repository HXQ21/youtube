# Sao chép thành .env.local (đã bị git bỏ qua) rồi điền giá trị thật, hoặc đặt biến ở mức người dùng (Windows: setx TEN_BIEN "gia-tri").
# Khóa chỉ được đọc trên máy bởi scripts/food.mjs; không nằm trong public/ nên không bao giờ vào bundle Remotion.
ELEVENLABS_API_KEY=your-key-here
# Tùy chọn: ghi đè cấu hình giọng trong episodes/<slug>/episode.json
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Tùy chọn: Chrome dùng để render và thư mục tạm của Remotion (nên ở ổ còn nhiều chỗ)
FOOD_CHROME=
REMOTION_TMP=
